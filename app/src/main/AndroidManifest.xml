<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISO DE RED REQUERIDO POR RETROFIT Y PICASSO -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".WalletApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_alkewallet"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_alkewallet"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlkeWallet"
        android:usesCleartextTraffic="true">

        <!-- SplashActivity configurada como la actividad inicial (LAUNCHER) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.AuthActivity" />
        <activity android:name=".ui.home.HomePageActivity" />
        <activity android:name=".ui.profile.ProfileActivity" />
        <activity android:name=".ui.transactions.SendMoneyActivity" />
        <activity android:name=".ui.transactions.RequestMoneyActivity" />

    </application>

</manifest>